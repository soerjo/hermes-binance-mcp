# Binance Futures MCP Server — Environment Variables
# Copy ke .env dan isi dengan API key Mas dari Binance
# PENTING: API key harus punya permission Futures Trading

BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Risk Management & Position Limits (default mengikuti src/config.ts)
MAX_OPEN_POSITIONS=5
DEFAULT_LEVERAGE=5
MAX_LEVERAGE=25
MAX_RISK_PER_TRADE_PCT=0.02
MAX_DAILY_LOSS_PCT=0.05

# Optional: HTTP/SOCKS5 proxy jika IP diblok Binance
# BINANCE_PROXY=socks5://127.0.0.1:1080
# DoH auto-tunnel aktif default (BINANCE_DOH_ENABLED=1) bila proxy kosong

# Tuning (optional)
SCAN_TOP_N=15
SCAN_INTERVAL=15m
RISK_REWARD=2.0
LOG_LEVEL=INFO
